window.__waReply = async (chatId, text, quotedId, chunkSize = 4000) => {
  const chat = await window.WWebJS.getChat(chatId, { getAsModel: false });
  if (!chat) throw new Error('no chat ' + chatId);
  const parts = [];
  let rest = text;
  while (rest.length > chunkSize) {
    let cut = rest.lastIndexOf('\n', chunkSize);
    if (cut < chunkSize * 0.5) cut = rest.lastIndexOf(' ', chunkSize);
    if (cut < chunkSize * 0.5) cut = chunkSize;
    parts.push(rest.slice(0, cut)); rest = rest.slice(cut).replace(/^\s+/, '');
  }
  if (rest) parts.push(rest);
  for (let i = 0; i < parts.length; i++) {
    try {
      await window.WWebJS.sendMessage(chat, parts[i], i === 0 && quotedId ? { quotedMessageId: quotedId } : {});
    } catch (e) {
      if (i !== 0 || !quotedId) throw e;
      await window.WWebJS.sendMessage(chat, parts[i], {});
