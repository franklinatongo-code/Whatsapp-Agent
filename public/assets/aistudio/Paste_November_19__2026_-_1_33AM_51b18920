private fun handleIncoming(json: String) {
    val m = JSONObject(json)
    val idObj = m.optJSONObject("id") ?: return
    val id      = idObj.optString("_serialized").ifEmpty { idObj.optString("\$1") }
    val fromMe  = idObj.optBoolean("fromMe")
    val chatId  = idObj.optString("remote")
    val type    = m.optString("type")
    val body    = m.optString("body")

    if (fromMe || id.isEmpty() || chatId.isEmpty()) return
    if (chatId == "status@broadcast") return
    if (!REPLY_TO_GROUPS && chatId.endsWith("@g.us")) return
    if (seen.contains(id)) return
    seen.add(id)

    if (type != "chat" || body.isBlank()) return   // text only for now

    evalJs("window.__waPresence && window.__waPresence(true)")
    evalJs("window.__waSeen && window.__waSeen(${q(chatId)})")
    typingWhile(chatId)

    try {
        val answer = Llm.reply(chatId, body.trim())   // <-- YOUR AI decides the reply
        typingDone(chatId)
        if (!answer.isNullOrBlank()) sendText(chatId, answer, id)
    } catch (e: Exception) {
        typingDone(chatId)
        Log.e(TAG, "reply failed", e)
    }
}
3. Sending the AI text back — chunk + quote
Why chunk: one giant evaluateJavascript string can fail, and WhatsApp looks better split. This keeps order because it awaits each send.
// add to wa_boot.js next to __waSend
window.__waReply = async (chatId, text, quotedId, chunkSize = 4000) => {
  const chat = await window.WWebJS.getChat(chatId, { getAsModel: false });
  if (!chat) throw new Error('no chat ' + chatId);

  const parts = [];
  let rest = text;
  while (rest.length > chunkSize) {
    let cut = rest.lastIndexOf('\n', chunkSize);
    if (cut < chunkSize * 0.5) cut = rest.lastIndexOf(' ', chunkSize);
    if (cut < chunkSize * 0.5) cut = chunkSize;
    parts.push(rest.slice(0, cut));
    rest = rest.slice(cut).replace(/^\s+/, '');
  }
  if (rest) parts.push(rest);

  for (let i = 0; i < parts.length; i++) {
    const opts = (i === 0 && quotedId) ? { quotedMessageId: quotedId } : {};
    try {
      await window.WWebJS.sendMessage(chat, parts[i], opts);
    } catch (e) {
      if (i !== 0 || !quotedId) throw e;         // quote failed -> retry plain
      await window.WWebJS.sendMessage(chat, parts[i], {});
    }
  }
};
private fun evalJs(code: String) = runOnUiThread {
    try { web.evaluateJavascript(code, null) } catch (_: Exception) {}
}
private fun q(s: String) = JSONObject.quote(s)

private fun sendText(chatId: String, text: String, quotedId: String?) {
    evalJs(
        "window.__waReply && window.__waReply(${q(chatId)}, ${q(text)}, " +
            (quotedId?.let { q(it) } ?: "null") + ")"
    )
}
