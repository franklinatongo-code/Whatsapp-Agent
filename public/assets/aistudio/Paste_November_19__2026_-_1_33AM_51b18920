import android.util.Log
import org.json.JSONArray
import org.json.JSONObject
import java.net.HttpURLConnection
import java.net.URL
import java.util.concurrent.ConcurrentHashMap

object Llm {
    private const val BASE_URL = "https://api.openai.com/v1/chat/completions"
    private const val MODEL = "gpt-4o-mini"
    private const val API_KEY = "" // blank = disabled
    private const val SYSTEM = "You are replying to WhatsApp messages on the owner's phone. Be brief and natural. Plain text, no markdown."
    private const val MAX_TURNS = 12

    private val history = ConcurrentHashMap<String, ArrayDeque<Pair<String, String>>>()

    fun isEnabled() = API_KEY.isNotBlank()

    fun reply(chatId: String, userText: String): String? {
        if (!isEnabled()) return null
        val turns = history.getOrPut(chatId) { ArrayDeque() }

        val messages = JSONArray()
        messages.put(JSONObject().put("role", "system").put("content", SYSTEM))
        synchronized(turns) {
            for ((role, content) in turns) {
                messages.put(JSONObject().put("role", role).put("content", content))
            }
        }
        messages.put(JSONObject().put("role", "user").put("content", userText))

        val payload = JSONObject()
            .put("model", MODEL)
            .put("temperature", 0.6)
            .put("max_tokens", 400)
            .put("messages", messages)

        val answer = post(payload) ?: return null
        synchronized(turns) {
            turns.addLast("user" to userText)
            turns.addLast("assistant" to answer)
            while (turns.size > MAX_TURNS) turns.removeFirst()
        }
        return answer
    }

    private fun post(payload: JSONObject): String? {
        var conn: HttpURLConnection? = null
        return try {
            val c = (URL(BASE_URL).openConnection() as HttpURLConnection).apply {
                requestMethod = "POST"; connectTimeout = 15_000; readTimeout = 60_000
                doOutput = true
                setRequestProperty("Content-Type", "application/json")
                setRequestProperty("Authorization", "Bearer $API_KEY")
            }
            conn = c
            c.outputStream.use { it.write(payload.toString().toByteArray()) }
            if (c.responseCode !in 200..299) {
                Log.e("Llm", "HTTP ${c.responseCode}: " + (c.errorStream?.bufferedReader()?.use { it.readText() } ?: ""))
                return null
            }
            JSONObject(c.inputStream.bufferedReader().use { it.readText() })
                .optJSONArray("choices")?.optJSONObject(0)
                ?.optJSONObject("message")?.optString("content")?.trim()
        } catch (e: Exception) {
            Log.e("Llm", "call failed", e); null
        } finally { conn?.disconnect() }
    }
}

