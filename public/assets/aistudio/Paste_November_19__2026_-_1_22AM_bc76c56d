(function () {
  if (window.__waBooted) return;
  window.__waBooted = true;

  const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
  const log = (...a) => { try { AndroidWA.log(a.map(x => typeof x === 'string' ? x : JSON.stringify(x)).join(' ')); } catch (e) {} };
  const emit = (fn, obj) => { try { AndroidWA[fn](JSON.stringify(obj)); } catch (e) {} };

  async function waitFor(pred, tries, ms) {
    for (let i = 0; i < tries; i++) {
      try { if (pred()) return true; } catch (e) {}
      await sleep(ms);
    }
    return false;
  }

  async function main() {
    log('boot: waiting for module loader');
    const ok = await waitFor(() => typeof window.require === 'function', 240, 500);
    if (!ok) { log('boot: window.require never appeared (WhatsApp Web changed)'); return; }

    // LoadUtils defines window.WWebJS.* — the exact injected helpers whatsapp-web.js uses.
    if (typeof window.WWebJS === 'undefined') {
      try { window.__loadWWebUtils(); } catch (e) { log('LoadUtils failed: ' + e); }
    }
    if (typeof window.WWebJS === 'undefined') { log('boot: WWebJS missing after LoadUtils'); return; }
    log('boot: WWebJS ready');

    // Send helper callable from Kotlin.
    window.__waSend = async function (chatId, text, quotedId) {
      const chat = await window.WWebJS.getChat(chatId, { getAsModel: false });
      if (!chat) throw new Error('chat not found: ' + chatId);
      const opts = quotedId ? { quotedMessageId: quotedId } : {};
      let content = text;
      if (text && typeof text === 'object') content = text; // media payload
      const sent = await window.WWebJS.sendMessage(chat, content, opts);
      return sent ? window.WWebJS.getMessageModel(sent) : null;
    };

    // Incoming messages: hook the same collection whatsapp-web.js hooks.
    let Msg;
    const gotMsg = await waitFor(() => {
      Msg = window.require('WAWebCollections').Msg;
      return !!Msg && typeof Msg.on === 'function';
    }, 120, 500);
    if (!gotMsg) { log('boot: Msg collection unavailable'); return; }

    Msg.on('add', function (msg) {
      try {
        if (!msg.isNewMsg) return;
        if (msg.type === 'ciphertext') {
          msg.once('change:type', function (m) {
            try { emit('onMessage', window.WWebJS.getMessageModel(m)); } catch (e) {}
          });
          return;
        }
        emit('onMessage', window.WWebJS.getMessageModel(msg));
      } catch (e) { log('msg hook error: ' + e); }
    });

    const state = window.require('WAWebSocketModel').Socket;
    if (state && typeof state.on === 'function') {
      state.on('change:state', function (_s, s) { emit('onState', { state: s }); });
      emit('onState', { state: state.state });
    }
    log('boot: listening');
  }

  main();
})();

