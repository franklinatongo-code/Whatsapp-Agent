class SeenStore(ctx: Context) {
    private val prefs = ctx.getSharedPreferences("wa_seen", Context.MODE_PRIVATE)
    @Synchronized fun seen(id: String) = prefs.getStringSet("ids", emptySet())!!.contains(id)
    @Synchronized fun markSeen(id: String) {
        val cur = prefs.getStringSet("ids", emptySet())!!.toMutableSet()
        cur.add(id)
        while (cur.size > 800) { cur.remove(cur.first()) } // not ordered
        prefs.edit().putStringSet("ids", cur).apply()
    }
}
